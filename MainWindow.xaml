<Window x:Class="VP.Field.Diagnostic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VP Field Diagnostic — Alpha 0.1" Height="760" Width="1080"
        MinHeight="600" MinWidth="860" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel>
                <TextBlock Text="VP Field Diagnostic" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="TSC3 connection and VP Field Sync compatibility check" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RescanButton" Content="Rescan" Width="110" Height="34" Margin="8,0,0,0" Click="Rescan_Click"/>
                <Button x:Name="SaveButton" Content="Save Report" Width="120" Height="34" Margin="8,0,0,0" Click="Save_Click" IsEnabled="False"/>
                <Button x:Name="CopyButton" Content="Copy Report" Width="120" Height="34" Margin="8,0,0,0" Click="Copy_Click" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,18,0,12" Padding="14" BorderThickness="1" CornerRadius="6" BorderBrush="#888">
            <StackPanel>
                <TextBlock x:Name="VerdictTitle" Text="NOT SCANNED" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="VerdictMessage" Text="Press Rescan to run a read-only diagnostic." Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="150"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="95"/>
                <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="260"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Value}" Width="*"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="Read-only diagnostic. No controller files, Windows services, drivers or registry values are modified." TextWrapping="Wrap"/>
    </Grid>
</Window>
